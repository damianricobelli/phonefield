{
  "name": "phonefield",
  "version": "2.1.0",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "description": "Composable, accessible React phone input primitives for Base UI, Radix UI, and React Aria, built on libphonenumber-js.",
  "keywords": [
    "react",
    "phone-input",
    "phone-number",
    "base-ui",
    "radix-ui",
    "react-aria",
    "libphonenumber"
  ],
  "author": "damianricobelli",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/damianricobelli/phonefield.git",
    "directory": "packages/phonefield"
  },
  "homepage": "https://phonefield.vercel.app",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "MIGRATION.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./base-ui": {
      "types": "./dist/base-ui/index.d.ts",
      "import": "./dist/base-ui.js",
      "default": "./dist/base-ui.js"
    },
    "./radix": {
      "types": "./dist/radix/index.d.ts",
      "import": "./dist/radix.js",
      "default": "./dist/radix.js"
    },
    "./react-aria": {
      "types": "./dist/react-aria/index.d.ts",
      "import": "./dist/react-aria.js",
      "default": "./dist/react-aria.js"
    },
    "./utils": {
      "types": "./dist/public-utils.d.ts",
      "import": "./dist/utils.js",
      "default": "./dist/utils.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup && node scripts/verify-package.mjs",
    "check": "biome check src tests scripts",
    "dev": "tsup --watch",
    "lint": "biome lint src tests scripts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@base-ui/react": ">=1.2.0 <2",
    "radix-ui": ">=1.1.0 <2",
    "react": ">=18 <20",
    "react-aria-components": ">=1.18.0 <2",
    "react-dom": ">=18 <20"
  },
  "peerDependenciesMeta": {
    "@base-ui/react": {
      "optional": true
    },
    "radix-ui": {
      "optional": true
    },
    "react-aria-components": {
      "optional": true
    }
  },
  "dependencies": {
    "libphonenumber-js": "^1.13.15"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.3",
    "radix-ui": "^1.8.1",
    "react-aria-components": "^1.22.1",
    "tsup": "^9.0.0",
    "typescript": "catalog:",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
